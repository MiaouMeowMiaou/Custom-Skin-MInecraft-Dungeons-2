<Application x:Class="MCD2SkinStudioWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
                <SolidColorBrush x:Key="WindowBackground" Color="#ECE9D8" />
        <SolidColorBrush x:Key="SidebarBackground" Color="#7A96DF" />
        <SolidColorBrush x:Key="ContentBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PanelBackground" Color="#ECE9D8" />

        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardHoverBackground" Color="#F2F6FE" />
        <SolidColorBrush x:Key="CardSelectedBackground" Color="#316AC5" />
        <SolidColorBrush x:Key="CardBorder" Color="#7F9DB9" />
        <SolidColorBrush x:Key="CardNestedBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardNestedBorder" Color="#7F9DB9" />

        <SolidColorBrush x:Key="SubtleBorder" Color="#D4D0C8" />
        <SolidColorBrush x:Key="SubtleFill" Color="#ECE9D8" />

        <SolidColorBrush x:Key="TextPrimary" Color="#000000" />
        <SolidColorBrush x:Key="TextSecondary" Color="#333333" />
        <SolidColorBrush x:Key="TextTertiary" Color="#666666" />

        <SolidColorBrush x:Key="AccentBlue" Color="#245EDC" />
        <SolidColorBrush x:Key="AccentBlueDark" Color="#103C8C" />
        <SolidColorBrush x:Key="AccentBlueHover" Color="#3D80E6" />
        <SolidColorBrush x:Key="AccentGreen" Color="#208E22" />
        <SolidColorBrush x:Key="AccentGreenHover" Color="#38BA36" />
        <SolidColorBrush x:Key="AccentGreenPressed" Color="#146118" />
        <SolidColorBrush x:Key="AccentGold" Color="#B87333" />
        <SolidColorBrush x:Key="AccentRed" Color="#CC292B" />

        <FontFamily x:Key="AppFontFamily">Tahoma, MS Sans Serif, Segoe UI, sans-serif</FontFamily>
        <FontFamily x:Key="DisplayFontFamily">Trebuchet MS, Tahoma, sans-serif</FontFamily>
        <FontFamily x:Key="SymbolFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol</FontFamily>

                <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="outerBorder"
                                BorderBrush="#003C74"
                                BorderThickness="1"
                                CornerRadius="3">
                            <Border x:Name="innerBorder"
                                    BorderBrush="#FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0.0" />
                                        <GradientStop Color="#ECEBE5" Offset="0.5" />
                                        <GradientStop Color="#D8D0C4" Offset="0.85" />
                                        <GradientStop Color="#EFEBD8" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outerBorder" Property="BorderBrush" Value="#E5A01A" />
                                <Setter TargetName="innerBorder" Property="BorderBrush" Value="#FFF7E0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="outerBorder" Property="BorderBrush" Value="#003C74" />
                                <Setter TargetName="innerBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#D8D0C4" Offset="0.0" />
                                            <GradientStop Color="#EAE7DF" Offset="0.5" />
                                            <GradientStop Color="#FFFFFF" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="outerBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="14,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="outerBorder"
                                BorderBrush="#103C8C"
                                BorderThickness="1"
                                CornerRadius="3">
                            <Border x:Name="innerBorder"
                                    BorderBrush="#82B1F1"
                                    BorderThickness="1,1,0,0"
                                    CornerRadius="2"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3D80E6" Offset="0.0" />
                                        <GradientStop Color="#245EDC" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect Color="#103C8C" ShadowDepth="1" BlurRadius="1" Direction="315" Opacity="0.8" />
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="innerBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#5D98EA" Offset="0.0" />
                                            <GradientStop Color="#3C73E7" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="innerBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#1E4A9C" Offset="0.0" />
                                            <GradientStop Color="#2358B0" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="outerBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="16,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="outerBorder"
                                BorderBrush="#146118"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Border x:Name="innerBorder"
                                    BorderBrush="#85E585"
                                    BorderThickness="1,1,0,0"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#38BA36" Offset="0.0" />
                                        <GradientStop Color="#28A627" Offset="0.4" />
                                        <GradientStop Color="#208E22" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect Color="#0E4210" ShadowDepth="1" BlurRadius="1" Direction="315" Opacity="0.9" />
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="innerBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4ADE4A" Offset="0.0" />
                                            <GradientStop Color="#2EAB2E" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="innerBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#208E22" Offset="0.0" />
                                            <GradientStop Color="#38BA36" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="outerBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#7F9DB9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#000000" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="boxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="boxBorder" Property="BorderBrush" Value="#245EDC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="chkBox"
                                    Grid.Column="0"
                                    Width="13" Height="13"
                                    Background="#FFFFFF"
                                    BorderBrush="#7F9DB9"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="chkGlyph"
                                           Text="✔"
                                           FontWeight="Bold"
                                           FontSize="10"
                                           Foreground="#215DC6"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-2,0,0"
                                           Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="6,0,0,0"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chkBox" Property="BorderBrush" Value="#E5A01A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chkGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <Style x:Key="WinUI3RadioButton" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="radioOuter"
                                    Grid.Column="0"
                                    Width="13" Height="13"
                                    CornerRadius="7"
                                    Background="#FFFFFF"
                                    BorderBrush="#7F9DB9"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="radioDot"
                                         Width="5" Height="5"
                                         Fill="#215DC6"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="6,0,0,0"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="radioOuter" Property="BorderBrush" Value="#E5A01A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="radioDot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#F4F3EE" />
            <Setter Property="BorderBrush" Value="#D4D0C8" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="2">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#C8D6FB" Offset="0.0" />
                                                            <GradientStop Color="#B7CAF5" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Grid>
                                                                                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Border Width="6" Height="1" Background="#FFFFFF" Margin="0,0,0,1" />
                                                            <Border Width="6" Height="1" Background="#8CB0F8" Margin="0,0,0,1" />
                                                            <Border Width="6" Height="1" Background="#FFFFFF" Margin="0,0,0,1" />
                                                            <Border Width="6" Height="1" Background="#8CB0F8" Margin="0,0,0,1" />
                                                            <Border Width="6" Height="1" Background="#FFFFFF" Margin="0,0,0,1" />
                                                            <Border Width="6" Height="1" Background="#8CB0F8" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
