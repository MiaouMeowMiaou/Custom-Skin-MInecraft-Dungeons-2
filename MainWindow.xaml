<Window x:Class="MCD2SkinStudioWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MCD2 Custom Skin"
        Icon="icone.png"
        Width="1320" Height="860"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}">

    <Window.Resources>
                <Style x:Key="XPTaskLinkStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#215DC6" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="Transparent"
                                Padding="4,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center" />
                                <TextBlock x:Name="txtCount"
                                           Grid.Column="1"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="10"
                                           Foreground="#555555"
                                           VerticalAlignment="Center"
                                           Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#428EFF" />
                                <Setter TargetName="border" Property="TextBlock.TextDecorations" Value="Underline" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#0024A7" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <Style x:Key="XPTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#ECE9D8" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Margin" Value="2,0,0,-1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder"
                                Background="#D8D0C4"
                                BorderBrush="#919B9C"
                                BorderThickness="1,1,1,0"
                                CornerRadius="3,3,0,0"
                                Padding="10,3">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#EBE8DE" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="tabBorder" Property="BorderThickness" Value="1,1,1,1" />
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#7F9DB9" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <Style TargetType="GroupBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#00138C" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    BorderBrush="#D4D0C8"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Margin="0,8,0,0"
                                    Background="#ECE9D8" />
                            <Border Grid.Row="0"
                                    HorizontalAlignment="Left"
                                    Margin="8,0,0,0"
                                    Background="#ECE9D8"
                                    Padding="4,0">
                                <ContentPresenter ContentSource="Header" />
                            </Border>
                            <Border Grid.Row="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <Style x:Key="HeroCardStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="160" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="cardBorder"
                                Background="#FFFFFF"
                                BorderBrush="#D4D0C8"
                                BorderThickness="1"
                                CornerRadius="2"
                                Cursor="Hand"
                                Padding="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="130" />
                                    <RowDefinition Height="46" />
                                </Grid.RowDefinitions>

                                                                <Border Grid.Row="0"
                                        Background="#245EDC"
                                        BorderBrush="#103C8C"
                                        BorderThickness="1">
                                    <Grid>
                                        <Image Source="{Binding IconSource}"
                                               Width="105" Height="105"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />

                                                                                <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="4"
                                                Background="{Binding ModifiedBadgeBackground}"
                                                BorderBrush="{Binding ModifiedBadgeBorder}"
                                                BorderThickness="1"
                                                Padding="4,1">
                                            <TextBlock Text="{Binding ModifiedBadgeText}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding ModifiedBadgeForeground}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                                                <StackPanel Grid.Row="1" Margin="2,4,2,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtHeroName"
                                               Text="{Binding Name}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#000000"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="txtHeroCategory"
                                               Text="{Binding BadgeText}"
                                               FontSize="10"
                                               Foreground="#555555"
                                               HorizontalAlignment="Center"
                                               Margin="0,1,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#E5A01A" />
                                <Setter TargetName="cardBorder" Property="Background" Value="#F2F6FE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#245EDC" />
                                <Setter TargetName="cardBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="cardBorder" Property="Background" Value="#D6DFF7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#ECE9D8">
        <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
        </Grid.RowDefinitions>

                <Border Grid.Row="0"
                Background="#ECE9D8"
                BorderBrush="#D4D0C8"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Upload Skin"
                            Style="{StaticResource AccentButton}"
                            Margin="0,0,6,0"
                            Click="BtnUploadSkin_Click" />
                    <Button x:Name="BtnRefresh"
                            Content="Refresh"
                            Margin="0,0,6,0"
                            Click="BtnRefresh_Click" />
                    <Button x:Name="BtnPaksFolder"
                            Content="Paks Folder"
                            Margin="0,0,6,0"
                            Click="BtnPaksFolder_Click" />
                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Search:"
                               FontSize="11"
                               Foreground="#000000"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <Grid Width="200">
                        <TextBox x:Name="TxtSearch"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 TextChanged="TxtSearch_TextChanged" />
                        <TextBlock x:Name="TxtSearchPlaceholder"
                                   Text="Filter heroes..."
                                   FontSize="11"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"
                                   IsHitTestVisible="False" />
                        <Button x:Name="BtnClearSearch"
                                Content="✕"
                                Width="18" Height="18"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed"
                                Click="BtnClearSearch_Click" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

                <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" MinWidth="480" />
                                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackground}"
                    BorderBrush="#6375D6"
                    BorderThickness="0,0,1,0"
                    Padding="10,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                                                <Border Background="#D6DFF7"
                                BorderBrush="#6375D6"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,0,0,12">
                            <StackPanel>
                                                                <Border CornerRadius="3,3,0,0" Padding="8,4">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#215DC6" Offset="0.0" />
                                            <GradientStop Color="#639AE7" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="Hero Categories"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#0F1089" ShadowDepth="1" BlurRadius="1" Direction="315" Opacity="0.8" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Border>

                                                                <StackPanel Margin="6,6,6,8">
                                    <RadioButton x:Name="NavAllHeroes"
                                                 GroupName="NavGroup"
                                                 IsChecked="True"
                                                 Tag="24"
                                                 Style="{StaticResource XPTaskLinkStyle}"
                                                 Checked="NavCategory_Checked"
                                                 Content="All heroes" />
                                    <RadioButton x:Name="NavModifiedHeroes"
                                                 GroupName="NavGroup"
                                                 Tag="0"
                                                 Style="{StaticResource XPTaskLinkStyle}"
                                                 Checked="NavCategory_Checked"
                                                 Content="Modified skins" />
                                    <RadioButton x:Name="NavBaseHeroes"
                                                 GroupName="NavGroup"
                                                 Tag="18"
                                                 Style="{StaticResource XPTaskLinkStyle}"
                                                 Checked="NavCategory_Checked"
                                                 Content="Base heroes" />
                                    <RadioButton x:Name="NavPrisoners"
                                                 GroupName="NavGroup"
                                                 Tag="4"
                                                 Style="{StaticResource XPTaskLinkStyle}"
                                                 Checked="NavCategory_Checked"
                                                 Content="Prisoners" />
                                    <RadioButton x:Name="NavPreOrders"
                                                 GroupName="NavGroup"
                                                 Tag="2"
                                                 Style="{StaticResource XPTaskLinkStyle}"
                                                 Checked="NavCategory_Checked"
                                                 Content="Pre-Orders" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                                                <Border Background="#D6DFF7"
                                BorderBrush="#6375D6"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel>
                                <Border CornerRadius="3,3,0,0" Padding="8,4">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#215DC6" Offset="0.0" />
                                            <GradientStop Color="#639AE7" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="Paks Location"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#0F1089" ShadowDepth="1" BlurRadius="1" Direction="315" Opacity="0.8" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Border>
                                <StackPanel Margin="8,8">
                                    <TextBlock x:Name="TxtPaksStatus"
                                               Text="Automatic detection"
                                               FontSize="10"
                                               Foreground="#215DC6"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

                        <Border Grid.Column="1"
                    Background="#ECE9D8"
                    Padding="10,8,6,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TxtPageTitle"
                                       Text="All heroes"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#00138C" />
                            <TextBlock x:Name="TxtHeroCountSubtitle"
                                       Text="24 heroes cataloged"
                                       FontSize="11"
                                       Foreground="#555555" />
                        </StackPanel>
                    </Grid>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <RadioButton Content="All" IsChecked="True" Style="{StaticResource XPTabButtonStyle}" Click="TabAll_Click" />
                        <RadioButton Content="Base" Style="{StaticResource XPTabButtonStyle}" Click="TabBase_Click" />
                        <RadioButton Content="Prisoners" Style="{StaticResource XPTabButtonStyle}" Click="TabPrisoners_Click" />
                        <RadioButton Content="Pre-Orders" Style="{StaticResource XPTabButtonStyle}" Click="TabPreOrders_Click" />
                        <RadioButton Content="Modified" Style="{StaticResource XPTabButtonStyle}" Click="TabModified_Click" />
                    </StackPanel>

                                        <Border Grid.Row="2"
                            Background="#FFFFFF"
                            BorderBrush="#7F9DB9"
                            BorderThickness="1"
                            Padding="8">
                        <ListBox x:Name="LbHeroes"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource HeroCardStyle}"
                                 SelectionMode="Single"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 SelectionChanged="LbHeroes_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

                        <Border Grid.Column="2"
                    Background="#ECE9D8"
                    BorderBrush="#D4D0C8"
                    BorderThickness="1,0,0,0"
                    Padding="10,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                                                <GroupBox Header="Selected Target">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="54" Height="54"
                                        Background="#245EDC"
                                        BorderBrush="#103C8C"
                                        BorderThickness="1"
                                        Margin="0,0,10,0">
                                    <Image x:Name="ImgSelectedHero"
                                           Width="48" Height="48"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSelectedHeroName"
                                               Text="No hero selected"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#000000" />
                                    <TextBlock x:Name="TxtSelectedHeroId"
                                               Text=""
                                               FontSize="10"
                                               Foreground="#555555" />
                                    <TextBlock x:Name="TxtSelectedHeroBlocks"
                                               Text=""
                                               FontSize="10"
                                               Foreground="#777777"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                                                <GroupBox Header="Current In-Game Skin">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Border x:Name="BadgeInGameStatus"
                                            Background="#D6DFF7"
                                            BorderBrush="#6375D6"
                                            BorderThickness="1"
                                            Padding="6,1"
                                            HorizontalAlignment="Left">
                                        <TextBlock x:Name="TxtInGameStatus"
                                                   Text="Vanilla"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="#0024A7" />
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#FFFFFF"
                                            BorderBrush="#7F9DB9"
                                            BorderThickness="1"
                                            Width="90" Height="90"
                                            Margin="0,0,10,0">
                                        <Image x:Name="ImgCurrentGameSkin3D"
                                               Width="86" Height="86"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Border BorderBrush="#7F9DB9"
                                                BorderThickness="1"
                                                Background="#FFFFFF"
                                                Width="42" Height="42"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,0,4">
                                            <Image x:Name="ImgCurrentGameSkin"
                                                   Width="42" Height="42"
                                                   Stretch="Fill"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </Border>
                                        <TextBlock x:Name="TxtCurrentSkinDetails"
                                                   Text="Extracted from game archives."
                                                   FontSize="10"
                                                   Foreground="#444444"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="TxtCurrentSkinActionHint"
                                                   Text="Custom skin active."
                                                   FontSize="10"
                                                   Foreground="#B87333"
                                                   FontWeight="Bold"
                                                   Margin="0,2,0,0"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnRestoreVanilla" Grid.Column="0" Content="Restore Vanilla" Click="BtnRestoreVanilla_Click" IsEnabled="False" />
                                    <Button x:Name="BtnExportInstalledSkin" Grid.Column="2" Content="Export Skin" Click="BtnExportInstalledSkin_Click" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                                                <GroupBox Header="Import Minecraft Skin">
                            <StackPanel>
                                <Border x:Name="DropArea"
                                        Background="#FFFFFF"
                                        BorderBrush="#7F9DB9"
                                        BorderThickness="1"
                                        Padding="10,8"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="DropArea_MouseLeftButtonDown"
                                        Margin="0,0,0,6">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtSkinFileName"
                                                   Text="Click to select skin (.png)..."
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#215DC6"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Standard 64x64 PNG format"
                                                   FontSize="10"
                                                   Foreground="#777777"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Arm Model:" FontSize="10" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,3" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="RbAuto" Grid.Column="0" Content="Auto" GroupName="ArmModel" IsChecked="True" Style="{StaticResource WinUI3RadioButton}" Checked="ArmModel_Checked" />
                                    <RadioButton x:Name="RbSteve" Grid.Column="1" Content="Steve (4px)" GroupName="ArmModel" Style="{StaticResource WinUI3RadioButton}" Checked="ArmModel_Checked" />
                                    <RadioButton x:Name="RbAlex" Grid.Column="2" Content="Alex (3px)" GroupName="ArmModel" Style="{StaticResource WinUI3RadioButton}" Checked="ArmModel_Checked" />
                                </Grid>
                                <TextBlock x:Name="TxtModelDetected"
                                           Text="Waiting for file..."
                                           FontSize="10"
                                           Foreground="#855A00" />
                            </StackPanel>
                        </GroupBox>

                                                <GroupBox Header="Preview &amp; Conversion">
                            <StackPanel>
                                <Border Background="#FFFFFF"
                                        BorderBrush="#7F9DB9"
                                        BorderThickness="1"
                                        Width="110" Height="110"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,6">
                                    <Image x:Name="ImgOriginal3D"
                                           Width="106" Height="106"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>

                                <Grid HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="Java" FontSize="9" Foreground="#555555" HorizontalAlignment="Center" />
                                        <Border BorderBrush="#7F9DB9" BorderThickness="1" Background="#FFFFFF" Width="44" Height="44">
                                            <Image x:Name="ImgOriginal" Width="44" Height="44" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="→" FontSize="14" Foreground="#7F9DB9" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0" />

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="MCD2" FontSize="9" Foreground="#555555" HorizontalAlignment="Center" />
                                        <Border BorderBrush="#7F9DB9" BorderThickness="1" Background="#FFFFFF" Width="44" Height="44">
                                            <Image x:Name="ImgConverted" Width="44" Height="44" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                        <TextBlock Text="Icon" FontSize="9" Foreground="#0024A7" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <Border BorderBrush="#245EDC" BorderThickness="1" Background="#FFFFFF" Width="44" Height="44">
                                            <Image x:Name="ImgIcon" Width="44" Height="44" Stretch="Uniform" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnExportSkin" Grid.Column="0" Content="Export MCD2" Click="BtnExportSkin_Click" IsEnabled="False" />
                                    <Button x:Name="BtnExportIcon" Grid.Column="2" Content="Export Icon" Click="BtnExportIcon_Click" IsEnabled="False" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                                                <GroupBox Header="Game Installation">
                            <StackPanel>
                                <CheckBox x:Name="ChkRemoveRelief"
                                          Content="Remove original relief &amp; reflections"
                                          IsChecked="True"
                                          Margin="0,0,0,8" />

                                                                <Button x:Name="BtnApply"
                                        Content="Apply to Game"
                                        Style="{StaticResource PrimaryActionBtn}"
                                        HorizontalAlignment="Stretch"
                                        Click="BtnApply_Click" />
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>

</Window>
